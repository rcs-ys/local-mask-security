{
  "name": "@local-mask-security/react",
  "version": "0.1.0",
  "description": "PII マスキング用 React Provider / Hooks",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react --external @local-mask-security/core",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "@local-mask-security/core": "0.1.0"
  },
  "dependencies": {
    "@local-mask-security/core": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "react": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.8.2"
  }
}
